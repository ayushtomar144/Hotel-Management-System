<% layout("/layouts/boilerplate")%>

<div class="row">

    <div class="col-8 offset-2">

        <h3>Create a New Product</h3>

        <br><br>

        <form action="/listings" method="POST"  novalidate class="needs-validation">

            <div class="mb-3">

                <label class="form-label">Title</label>

                <input 
                name="new_listing[title]"
                placeholder="enter title"
                class="form-control" required>

                <div class="valid-feedback">Title looks good</div>
            </div>

            <div class="mb-3">

                <label class="form-label">Description</label>

                <textarea 
                name="new_listing[description]"
                placeholder="enter description"
                class="form-control" required></textarea>
                     <div class="invalid-feedback">Enter Description</div>
            </div>

            <div class="mb-3">

                <label class="form-label">Image Link</label>

                <input 
                name="new_listing[image]"
                placeholder="enter image url"
                class="form-control" required>

                <div class="invalid-feedback">Provide image!!</div>
            </div>

            <div class="mb-3">

                <label class="form-label">Price</label>

                <input 
                name="new_listing[price]"
                placeholder="enter price"
                class="form-control" required>

                <div class="invalid-feedback">Enter Price</div>

            </div>

            <div class="mb-3">

                <label class="form-label">Location</label>

                <input 
                name="new_listing[location]"
                placeholder="enter location"
                class="form-control" required>

                <div class="invalid-feedback">Enter location</div>

            </div>

            <div class="mb-3">

                <label class="form-label">Country</label>

                <input 
                name="new_listing[country]"
                placeholder="enter country"
                class="form-control" required>

                <div class="invalid-feedback">Enter country</div>
            </div>

            <button class="btn btn-dark add-btn">
                Add
            </button>

        </form>

        <br><br>

    </div>

</div>